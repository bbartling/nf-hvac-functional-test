{
  "hook": {
    "name": "tick",
    "entryPoint": "hooks/tick.js",
    "mode": "MODE_SCHEDULED",
    "schedule": {
      "rrule": "RRULE:FREQ=SECONDLY;INTERVAL=10"
    },
    "invokeTimeout": "8s",
    "globalVariables": [
      { "label": "ftest_state" },
      { "label": "ftest_step_index" },
      { "label": "ftest_run_seq" },
      { "label": "ftest_overrides_active" },
      { "label": "ftest_needs_attention" }
    ]
  }
}
