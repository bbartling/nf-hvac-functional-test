{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "noImplicitOverride": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["lib/**/*.js", "scripts/**/*.js", "test/**/*.js"]
}
